<mvc:View
    controllerName="bookshop.controller.CourceList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="OData V4 Product List">
        <List
            id="idProductList"
            items="{
                path: '/Cources',
                parameters: {
                    $select: 'course_name,price'
                }
            }">
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Products" />
                </OverflowToolbar>
            </headerToolbar>
            <StandardListItem
                title="{course_name}"
                info="{price}"
                infoState="Success" />
        </List>

        <!-- <List items="{EmpModel>/Employee}">
          <StandardListItem title="{EmpModel>Name}" description="{EmpModel>Role}">
          </StandardListItem>
        </List> -->
    </Page>
</mvc:View>